{
  "name": "propriety-horizon-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "Backend REST API + WebSocket para Propiedad Horizontal / Condominios",
  "main": "./src/main.ts",
  "scripts": {
    "dev": "tsx watch --cwd ts/src main.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "db:migrate": "prisma migrate dev --name init",
    "db:seed": "tsx dist/seed/seed.js",
    "test": "vitest"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "cors": "^2.8.5",
    "dayjs": "^1.11.13",
    "express": "^4.21.1",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.6",
    "tsx": "^4.19.2",
    "@tsconfig/node20": "^20.1.4",
    "prisma": "^5.20.0",
    "typescript": "^5.6.3"
  }
}
