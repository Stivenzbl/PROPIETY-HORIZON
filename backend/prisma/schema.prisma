// Prisma Schema - PROPIETY-HORIZON
// Sistema de Gestión de Propiedad Horizontal
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Basic models without complex relations for initial setup
model User {
  id        String    @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("RESIDENT")
  createdAt DateTime @default(now())
}

model Building {
  id        String    @id @default(uuid())
  name      String
  address   String
  city      String
}

model Unit {
  id        String    @id @default(uuid())
  buildingId String
  number    String
  area      Float
}

model Payment {
  id        String    @id @default(uuid())
  amount    Float
  status    String    @default("PENDING")
}

model Service {
  id        String    @id @default(uuid())
  name      String
  price     Float?
}

model MaintenanceRequest {
  id        String    @id @default(uuid())
  title     String
  status    String    @default("PENDING")
}