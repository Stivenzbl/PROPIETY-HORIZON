{
  "name": "propriety-horizon-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "@server:dev": "tsx watch --cwd src/server main.ts",
    "@server:serve": "pnpm -w@propriety-horizon-server run @server:build",
    "@server:start": "tsx --cwd src/server main.ts",
    "@prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev --name init"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "cors": "^2.8.5",
    "uuid": "^11.0.4",
    "@prisma/client": "^6.0.1",
    "express-concurrency": "^5.3.0",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^3.0.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.2",
    "@types/node": "^20.16.12",
    "prisma": "^6.0.1"
  }
}
