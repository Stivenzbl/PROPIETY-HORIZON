{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/qwen-claude-backend",
  "small_model": "ollama/qwen-claude-backend",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama local",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1",
        "apiKey": "ollama"
      },
      "models": {
        "qwen-claude-backend": {
          "name": "Qwen local 9B NVFP4",
          "limit": {
            "context": 32768,
            "output": 2048
          }
        }
      }
    }
  },
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 14000
    },
    "buffer": 9000
  },
  "instructions": [
    "AGENTS.md",
    "docs/AI_CONTEXT.md"
  ],
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      ".next/**",
      ".git/**"
    ]
  }
}
